        <mxCell id="gp" value="ACTIVE + PENDING&#xa;replacement stored" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;fontColor=default;fontStyle=1;" vertex="1" parent="gg">
