        </mxCell>
        <mxCell id="ga" value="ACTIVE&#xa;routine running" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;fontColor=default;fontStyle=1;" vertex="1" parent="gg">
