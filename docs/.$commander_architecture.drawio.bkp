        </mxCell>
        <mxCell id="le1" value="activate / create actor" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="lg" source="lc" target="la">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le2" value="deactivate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="lg" source="la" target="ld">
