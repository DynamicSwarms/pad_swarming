        </mxCell>
        <mxCell id="ld" value="DEACTIVATING&#xa;services removed&#xa;locked Return pending/running" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=default;fontColor=default;fontStyle=1;" vertex="1" parent="lg">
