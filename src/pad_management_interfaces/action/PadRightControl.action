# Goal - sent by CF
string name 
uint8 action

builtin_interfaces/Duration max_wait_time # time to wait for right acquisition before giving up
builtin_interfaces/Duration usage_time # expected time to use the right after acquisition 

float32 battery_percentage # battery percentage of the requesting CF
geometry_msgs/PoseStamped current_pose

uint8 ACTION_LAND = 0
uint8 ACTION_TAKEOFF = 1
uint8 ACTION_PLACE_ON = 2
uint8 ACTION_REMOVE = 3
---
# Result - sent by Pad
string reason
bool success # true if canceled by client, false if lock timeouted etc.
---
# Feedback - sent by Pad
uint8 status
builtin_interfaces/Duration time_remaining # expected time until acquisition or time left until timeout

geometry_msgs/PoseStamped target_pose # target pose to land on or takeoff from



uint8 STATUS_WAITING_FOR_RIGHT = 0
uint8 STATUS_ACQUIRED_RIGHT = 1