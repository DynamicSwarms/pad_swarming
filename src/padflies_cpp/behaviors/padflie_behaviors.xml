<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Land">
    <Sequence>
      <ReactiveSequence>
        <PrintStuff2/>
        <ReactiveSequence>
          <PrintStuff/>
          <AcquirePadRight/>
        </ReactiveSequence>
      </ReactiveSequence>
      <SubTree ID="LandRoutine"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="LandRoutine">
    <Sequence>
      <CalculateAbovePadTarget target="{target}"
                               height="0.25"/>
      <HLCommandGoTo target="{target}"
                     duration="4.5"
                     relative="false"/>
      <WaitFor duration="4.5"/>
      <CalculateAbovePadTarget target="{target}"
                               height="-0.1"/>
      <HLCommandGoTo target="{target}"
                     duration="3.0"
                     relative="false"/>
      <WaitFor duration="1.0"/>
      <CalculateAbovePadTarget target="{target}"
                               height="-0.4"/>
      <SplitPose pose="{target}"
                 x="{x}"
                 y="{_}"
                 z="{height}"
                 yaw="{yaw}"/>
      <HLCommandLand height="{height}"
                     duration="1.0"
                     yaw="{yaw}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="LandSimple">
    <Sequence>
      <HLCommandLand yaw="0.0"/>
      <WaitFor duration="2.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Takeoff">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="TakeoffSimple">
    <Sequence>
      <HLCommandTakeoff yaw="0.0"/>
      <WaitFor duration="2.0"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AcquirePadRight"
            editable="true"/>
    <Action ID="CalculateAbovePadTarget"
            editable="true">
      <output_port name="target"
                   type="Eigen::Affine3d"/>
      <input_port name="height"
                  type="double"/>
    </Action>
    <Action ID="HLCommandGoTo"
            editable="true">
      <input_port name="target"
                  type="Eigen::Affine3d"/>
      <input_port name="duration"
                  type="double"/>
      <input_port name="relative"
                  type="bool"/>
    </Action>
    <Action ID="HLCommandLand"
            editable="true">
      <input_port name="height"
                  default="0.0"
                  type="double"/>
      <input_port name="duration"
                  default="4.0"
                  type="double"/>
      <input_port name="yaw"
                  default="0.0"
                  type="double">In degrees</input_port>
    </Action>
    <Action ID="HLCommandTakeoff"
            editable="true">
      <input_port name="heigth"
                  default="1.0"
                  type="double"/>
      <input_port name="duration"
                  default="4.0"
                  type="double"/>
      <input_port name="yaw"
                  default="0.0"
                  type="double"/>
    </Action>
    <Action ID="PrintStuff"
            editable="true"/>
    <Action ID="PrintStuff2"
            editable="true"/>
    <Action ID="SplitPose"
            editable="true">
      <input_port name="pose"
                  type="Eigen::Affine3d"/>
      <output_port name="x"
                   type="double"/>
      <output_port name="y"
                   type="double"/>
      <output_port name="z"
                   type="double"/>
      <output_port name="yaw"
                   type="double"/>
    </Action>
    <Action ID="WaitFor"
            editable="true">
      <input_port name="duration"
                  type="double"/>
    </Action>
  </TreeNodesModel>

</root>
