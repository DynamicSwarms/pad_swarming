<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="GetRights">
    <Sequence>
      <ChoosePad pad_right_client="{client}"/>
      <GetPadRight pad_right_client="{client}"/>
      <Fallback>
        <Sequence>
          <RetryUntilSuccessful num_attempts="10">
            <ReactiveSequence>
              <GoalResponded pad_right_client="{client}"/>
              <GoalAccepted pad_right_client="{client}"/>
            </ReactiveSequence>
          </RetryUntilSuccessful>
          <RetryUntilSuccessful num_attempts="400">
            <HasRight pad_right_client="{client}"/>
          </RetryUntilSuccessful>
          <ReactiveSequence>
            <HasRight pad_right_client="{client}"/>
            <SubTree ID="LandRoutine"/>
          </ReactiveSequence>
        </Sequence>
        <CancelRight pad_right_client="{client}"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Land">
    <Sequence>
      <ReactiveSequence>
        <PrintStuff2/>
        <ReactiveSequence>
          <PrintStuff/>
          <AcquirePadRight/>
        </ReactiveSequence>
      </ReactiveSequence>
      <SubTree ID="LandRoutine"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="LandRoutine">
    <Sequence>
      <CalculateAbovePadTarget target="{target}"
                               height="0.25"/>
      <HLCommandGoTo target="{target}"
                     duration="4.5"
                     relative="false"/>
      <WaitFor duration="4.5"/>
      <CalculateAbovePadTarget target="{target}"
                               height="-0.1"/>
      <HLCommandGoTo target="{target}"
                     duration="3.0"
                     relative="false"/>
      <WaitFor duration="1.0"/>
      <CalculateAbovePadTarget target="{target}"
                               height="-0.4"/>
      <SplitPose pose="{target}"
                 x="{x}"
                 y="{y}"
                 z="{height}"
                 yaw="{yaw}"/>
      <HLCommandLand height="{height}"
                     duration="1.0"
                     yaw="{yaw}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="LandSimple">
    <Sequence>
      <HLCommandLand height="0.0"
                     duration="4.0"
                     yaw="0.0"/>
      <WaitFor duration="2.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Takeoff">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="TakeoffSimple">
    <Sequence>
      <HLCommandTakeoff heigth="1.0"
                        duration="4.0"
                        yaw="0.0"/>
      <WaitFor duration="2.0"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AcquirePadRight"
            editable="true"/>
    <Action ID="CalculateAbovePadTarget"
            editable="true">
      <output_port name="target"
                   type="Eigen::Affine3d"/>
      <input_port name="height"
                  type="double"/>
    </Action>
    <Action ID="CancelRight"
            editable="true">
      <input_port name="pad_right_client"
                  type="std::shared_ptr&lt;PadRightClient&gt;"/>
    </Action>
    <Action ID="ChoosePad"
            editable="true">
      <output_port name="pad_right_client"
                   type="std::shared_ptr&lt;PadRightClient&gt;"/>
    </Action>
    <Action ID="GetPadRight"
            editable="true">
      <input_port name="pad_right_client"
                  type="std::shared_ptr&lt;PadRightClient&gt;"/>
    </Action>
    <Condition ID="GoalAccepted"
               editable="true">
      <input_port name="pad_right_client"
                  type="std::shared_ptr&lt;PadRightClient&gt;"/>
    </Condition>
    <Condition ID="GoalResponded"
               editable="true">
      <input_port name="pad_right_client"
                  type="std::shared_ptr&lt;PadRightClient&gt;"/>
    </Condition>
    <Action ID="HLCommandGoTo"
            editable="true">
      <input_port name="target"
                  type="Eigen::Affine3d"/>
      <input_port name="duration"
                  type="double"/>
      <input_port name="relative"
                  type="bool"/>
    </Action>
    <Action ID="HLCommandLand"
            editable="true">
      <input_port name="height"
                  default="0.0"
                  type="double"/>
      <input_port name="duration"
                  default="4.0"
                  type="double"/>
      <input_port name="yaw"
                  default="0.0"
                  type="double">In degrees</input_port>
    </Action>
    <Action ID="HLCommandTakeoff"
            editable="true">
      <input_port name="heigth"
                  default="1.0"
                  type="double"/>
      <input_port name="duration"
                  default="4.0"
                  type="double"/>
      <input_port name="yaw"
                  default="0.0"
                  type="double"/>
    </Action>
    <Condition ID="HasRight"
               editable="true">
      <input_port name="pad_right_client"
                  type="std::shared_ptr&lt;PadRightClient&gt;"/>
    </Condition>
    <Action ID="PrintStuff"
            editable="true"/>
    <Action ID="PrintStuff2"
            editable="true"/>
    <Action ID="SplitPose"
            editable="true">
      <input_port name="pose"
                  type="Eigen::Affine3d"/>
      <output_port name="x"
                   type="double"/>
      <output_port name="y"
                   type="double"/>
      <output_port name="z"
                   type="double"/>
      <output_port name="yaw"
                   type="double"/>
    </Action>
    <Action ID="WaitFor"
            editable="true">
      <input_port name="duration"
                  type="double"/>
    </Action>
  </TreeNodesModel>

</root>
