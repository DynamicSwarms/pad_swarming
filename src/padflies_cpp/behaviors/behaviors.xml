<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="LandBehavior">
    <Sequence>
      <ChoosePad pad_client="{client}"/>
      <ReactiveSequence>
        <ApproachIDLE pad_client="{client}"/>
        <SendFeedback pad_client="{client}"/>
        <TimeoutROS timeout_ms="1000">
          <GetPadRight pad_client="{client}"
                       action="LAND"/>
        </TimeoutROS>
      </ReactiveSequence>
      <Repeat num_cycles="10">
        <Delay delay_msec="1000">
          <ApproachIDLE pad_client="{client}"/>
        </Delay>
      </Repeat>
      <ForceSuccess>
        <ReactiveSequence>
          <HasPadRight pad_client="{client}"/>
          <SendFeedback pad_client="{client}"/>
          <TimeoutROS timeout_ms="500">
            <AsyncSequence>
              <ApproachCLOSE pad_client="{client}"/>
              <Land pad_client="{client}"/>
            </AsyncSequence>
          </TimeoutROS>
        </ReactiveSequence>
      </ForceSuccess>
      <ReleasePadRight pad_client="{client}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TakeoffBehavior">
    <AlwaysSuccess/>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ApproachCLOSE"
            editable="true">
      <input_port name="pad_client"
                  type="std::shared_ptr&lt;PadClient&gt;"/>
    </Action>
    <Action ID="ApproachIDLE"
            editable="true">
      <input_port name="pad_client"
                  type="std::shared_ptr&lt;PadClient&gt;"/>
    </Action>
    <Action ID="ChoosePad"
            editable="true">
      <output_port name="pad_client"
                   type="std::shared_ptr&lt;PadClient&gt;"/>
    </Action>
    <Action ID="GetPadRight"
            editable="true">
      <input_port name="pad_client"
                  type="std::shared_ptr&lt;PadClient&gt;"/>
      <input_port name="action"
                  default="TAKEOFF"
                  type="std::string">either TAKEOFF or LAND</input_port>
    </Action>
    <Condition ID="HasPadRight"
               editable="true">
      <input_port name="pad_client"
                  type="std::shared_ptr&lt;PadClient&gt;"/>
    </Condition>
    <Action ID="Land"
            editable="true">
      <input_port name="pad_client"
                  type="std::shared_ptr&lt;PadClient&gt;"/>
    </Action>
    <Action ID="ReleasePadRight"
            editable="true">
      <input_port name="pad_client"
                  type="std::shared_ptr&lt;PadClient&gt;"/>
    </Action>
    <Action ID="SendFeedback"
            editable="true">
      <input_port name="pad_client"
                  type="std::shared_ptr&lt;PadClient&gt;"/>
    </Action>
    <Decorator ID="TimeoutROS"
               editable="true">
      <input_port name="timeout_ms"
                  type="int"/>
    </Decorator>
  </TreeNodesModel>

</root>
